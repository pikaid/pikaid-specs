{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "properties.schema.json",
  "title": "PikaID conformance properties cases",
  "type": "object",
  "properties": {
    "suite": {
      "const": "properties"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "requirement_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{3}$"
            }
          },
          "scope": {
            "enum": [
              "mandatory",
              "conditional",
              "audit"
            ]
          },
          "strategy": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "minimum_trials": {
            "type": "integer",
            "minimum": 0
          },
          "assertion": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "id",
          "requirement_refs",
          "scope",
          "strategy",
          "minimum_trials",
          "assertion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "suite",
    "cases"
  ],
  "additionalProperties": false
}
