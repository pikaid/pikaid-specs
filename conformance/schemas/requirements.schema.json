{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement registry schema",
  "type": "object",
  "properties": {
    "suite": {
      "const": "normative-requirements"
    },
    "spec_revision": {
      "const": "1.0.4"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "level": {
            "enum": [
              "MUST",
              "SHOULD",
              "CONDITIONAL_MUST",
              "CONDITIONAL_MAY"
            ]
          },
          "spec_section": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "level",
          "spec_section",
          "statement",
          "verification"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "suite",
    "spec_revision",
    "requirements"
  ],
  "additionalProperties": false
}
