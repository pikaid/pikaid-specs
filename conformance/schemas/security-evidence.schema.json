{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-evidence.schema.json",
  "title": "PikaID implementation-specific manual security evidence",
  "type": "object",
  "required": [
    "format",
    "implementation_id",
    "implementation_commit",
    "spec_revision",
    "suite_revision",
    "reviewed_at_utc",
    "reviewer",
    "checks"
  ],
  "properties": {
    "format": {
      "const": "pikaid-csprng-review-v1"
    },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "spec_revision": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "suite_revision": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "reviewed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "P-GENERATE-RNG-SOURCE",
              "P-GENERATE-RNG-FAILURE"
            ]
          },
          "result": {
            "const": "PASS"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "line_start",
                "line_end"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\x00-\\x1F\\\\:]+$"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "implementation_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  },
  "additionalProperties": false
}
