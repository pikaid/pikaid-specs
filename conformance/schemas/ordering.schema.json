{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ordering.schema.json",
  "title": "PikaID conformance ordering cases",
  "type": "object",
  "properties": {
    "suite": {
      "const": "ordering"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "requirement_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{3}$"
            }
          },
          "a_pikaid": {
            "type": "string",
            "pattern": "^[0-9a-z]{26}$"
          },
          "b_pikaid": {
            "type": "string",
            "pattern": "^[0-9a-z]{26}$"
          },
          "a_binary_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{34}$"
          },
          "b_binary_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{34}$"
          },
          "expected_compare": {
            "enum": [
              -1,
              0,
              1
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        },
        "required": [
          "id",
          "requirement_refs",
          "a_pikaid",
          "b_pikaid",
          "a_binary_hex",
          "b_binary_hex",
          "expected_compare"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "suite",
    "cases"
  ],
  "additionalProperties": false
}
