      ],
      "timestamp_seconds": null,
      "expected": "canonical_valid_binary_timestamp_between_clock_bounds"
    },
    {
      "id": "G-BINARY-WITH-TIMESTAMP-MAX",
      "mode": "caller_supplied_binary",
      "scope": "conditional",
      "iteration_count": 8,
      "requirement_refs": [
        "GENT-001",
        "GENB-001"
      ],
      "timestamp_seconds": 78364164095,
      "expected": "canonical_valid_binary_with_exact_timestamp"
    },
    {
      "id": "G-BINARY-WITH-TIMESTAMP-BELOW",
      "mode": "caller_supplied_binary",
