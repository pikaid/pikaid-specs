      "expected": "reject"
    },
    {
      "id": "G-BINARY-WITH-TIMESTAMP-ABOVE",
      "mode": "caller_supplied_binary",
      "scope": "conditional",
      "iteration_count": 1,
      "requirement_refs": [
        "GENT-001",
        "GENB-001"
      ],
      "timestamp_seconds": 78364164096,
      "expected": "reject"
